<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog
        id="notificationDialog"
        title="Notifications"
        class="sapUiResponsivePadding--header sapUiResponsivePadding--content sapUiResponsivePadding--footer"
        stretch="{device>/system/phone}">
        <content>
            <List id="notificationList">
                <CustomListItem id="_IDGenCustomListItem1">
                    <VBox id="_IDGenVBox1">
                        <Text id="_IDGenText1" text="{Type}" />
                        <Text id="_IDGenText2" text="{DateNotif}" />
                        <Text id="_IDGenText3" text="{SentBy}" />
                    </VBox>
                </CustomListItem>
            </List>
        </content>
        <buttons>
            <Button id="_IDGenButton1" text="Close" press="onCloseNotificationDialog"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>
