<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    controllerName="management.controller.Consultants.Profile.ConsultantDetails"
    height="100%"
    displayBlock="true"
>
    <Table
        id="idProductsTable"
        items="{TICKETIDDATA>/Tickets}"
    >
        <headerToolbar>
            <Toolbar id="toolbar">
                <ToolbarSpacer id="toolbarSpacer" />
                <SearchField
                    id="searchField"
                    width="auto"
                    search="onSearch"
                    liveChange="onSearch"
                />
            </Toolbar>
        </headerToolbar>
        <columns>
            <Column id="columnIdJira">
                <Text
                    id="textIdJira"
                    text="ID (Jira)"
                    class="theadProfile"
                />
            </Column>
            <Column id="columnTitre">
                <Text
                    id="textczeTitre"
                    text="Titre"
                    class="theadProfile"
                />
            </Column>
            <Column id="columnProjet">
                <Text
                    id="textProezjet"
                    text="Projet"
                    class="theadProfile"
                />
            </Column>
            <Column id="columnCreatedBy">
                <Text
                    id="textCreavzatedBy"
                    text="Created By"
                    class="theadProfile"
                />
            </Column>
            <Column id="columnStatus">
                <Text
                    id="textveStatus"
                    text="Status"
                    class="theadProfile"
                />
            </Column>
            <Column id="columnTechnology">
                <Text
                    id="textTechvaznology"
                    text="Technology"
                    class="theadProfile"
                />
            </Column>
        </columns>
        <items>
            <ColumnListItem id="columnListItem">
                <cells>
                    <Link
                        id="linkIdJira"
                        text="{TICKETIDDATA>IdJira}"
                        press="showTicketInfo"
                    />
                    <Text
                        id="textTitre"
                        text="{TICKETIDDATA>Titre}"
                    />
                    <Text
                        id="textProjet"
                        text="{TICKETIDDATA>ProjectName}"
                    />
                    <Text
                        id="textCreatedBy"
                        text="{TICKETIDDATA>CreatedByName}"
                    />
                    <Text
                        id="textStatus"
                        text="{TICKETIDDATA>Status}"
                    />
                    <Text
                        id="textTechnology"
                        text="{TICKETIDDATA>Technology}"
                    />
                </cells>
            </ColumnListItem>
        </items>
    </Table>
</mvc:View>
